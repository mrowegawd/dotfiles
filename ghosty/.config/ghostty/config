# vim: ft=ini
# +-----------------------------------------------------------+
# | FONTS                                                     |
# +-----------------------------------------------------------+
font-family                     = "Liberation Mono"

font-size                       = 9.5
# font-feature                  = -calt
# font-feature                  = -liga
# font-feature                  = -dlig

# +-----------------------------------------------------------+
# | MOUSE                                                     |
# +-----------------------------------------------------------+
mouse-hide-while-typing         = false

# +-----------------------------------------------------------+
# | THEME                                                     |
# +-----------------------------------------------------------+
theme = cendre

# +-----------------------------------------------------------+
# | WINDOW                                                    |
# +-----------------------------------------------------------+
window-decoration               = none
window-padding-x                = 5
window-padding-y                = 5
# window-colorspace               = display-p3
window-padding-balance          = true
window-step-resize              = false
window-theme                    = ghostty

# +-----------------------------------------------------------+
# | MISC                                                      |
# +-----------------------------------------------------------+
custom-shader = shaders/cursor_wrap.glsl

resize-overlay                  = never
cursor-style                    = block
cursor-style-blink              = false
confirm-close-surface           = false
shell-integration-features      = no-cursor

gtk-titlebar                    = false
gtk-single-instance             = true

# unfocused-split-opacity         = 0.5
# adjust-cell-width               = 0
# adjust-cell-height              = 20%
# shell-integration-features      = no-cursor
# background-blur-radius          = 20
# macos-titlebar-style            = tabs

# NOTE: jika background-opacity ini active dan picom juga active
# maka akam mempengaruhi color background, menjadikan color background terminal
# ghostty ini tidak sama dengan color terminal lain (wezterm, kitty),
# recommended: gunakan picom untuk transparant nya, disable `background-opacity`
# background-opacity              = 0.85


# +-----------------------------------------------------------+
# | MAPPINGS                                                  |
# +-----------------------------------------------------------+
# clear all default mappings, to unbind specific mapping --> use ex: ctrl+enter=unbind
keybind = clear

# ┏╍╍╍╍╍╍┓
# ╏ MISC ╏
# ┗╍╍╍╍╍╍┛
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+enter=unbind

keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# keybind = performable:alt+m=toggle_split_zoom

keybind = ctrl+shift+comma=reload_config
# keybind = alt+shift+r=reload_config
# keybind = global:alt+f=toggle_quick_terminal # (Mac only)

# ┏╍╍╍╍╍┓
# ╏ TAB ╏
# ┗╍╍╍╍╍┛
# keybind = shift+alt+n=new_tab
# keybind = ctrl+alt+l=next_tab
# keybind = ctrl+alt+h=previous_tab
# keybind = ctrl+alt+h=previous_tab

# ┏╍╍╍╍╍╍┓
# ╏ PANE ╏
# ┗╍╍╍╍╍╍┛
# keybind = performable:alt+h=goto_split:left
# keybind = performable:alt+j=goto_split:down
# keybind = performable:alt+k=goto_split:up
# keybind = performable:alt+l=goto_split:right

# keybind = unconsumed:alt+enter=new_split:right
# keybind = ctrl+space>j=new_split:down
# keybind = ctrl+space>l=new_split:right

keybind =performable:alt+shift+k=resize_split:up,20
keybind =performable:alt+shift+h=resize_split:left,20
keybind =performable:alt+shift+j=resize_split:down,20
keybind =performable:alt+shift+l=resize_split:right,20
