#!/usr/bin/env bash
# ┏╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍┓
# ╏                                    CONFIG                                    ╏
# ┗╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍┛
# Every variable below can be overridden from this config file. Example:
#   : "${PASS_GIT_REPO:=git@github.com:user/pass.git}"
#   : "${PASS_KEY_IN_REPO:=0}"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/rofi-websearch/config"
# shellcheck source=/dev/null
[[ -f $CONFIG_FILE ]] && source "$CONFIG_FILE"

FILE_BOOKMARKED="${FILE_BOOKMARKED:-$HOME/Dropbox/neorg/orgmode/bookmarks/urls.org}"

# PASS_DIR = the working copy, which is also the (private) git repo on GitHub
PASS_DIR="${PASSWORD_STORE_DIR:-$HOME/.password-store}"
PASS_DIR="${PASS_DIR%/}"
PASS_GIT_REPO="${PASS_GIT_REPO:-}" # empty = resolved later

# GPG backup: filename is auto-generated as <name>-<created>_<expires>.asc
PASS_KEY_DIR="${PASS_KEY_DIR:-$HOME/Dropbox}"
PASS_KEY_SUBDIR="${PASS_KEY_SUBDIR:-gpg-backup}"
PASS_KEY_IN_REPO="${PASS_KEY_IN_REPO:-1}"
CLIP_TIMEOUT="${CLIP_TIMEOUT:-45}"

# Operation logs, audit reports, and snapshots taken before rekey (private folder, mode 700)
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/rofi-websearch"
LOG_FILE="$STATE_DIR/ops.log"
REPORT_DIR="$STATE_DIR/reports"
BACKUP_DIR="$STATE_DIR/backups"
[[ -d $REPORT_DIR && -d $BACKUP_DIR ]] || (umask 077 && mkdir -p "$STATE_DIR" "$REPORT_DIR" "$BACKUP_DIR")

ROFI_DIR="$HOME/.config/rofi/menu"
ROFI_THEME_SNIPPETS="styles/snippets"
ROFI_THEME_MENULEFT="styles/big_screen"

export PASSWORD_STORE_DIR="$PASS_DIR"
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o ConnectTimeout=15}"

# ├─────────────────────────────────┤ LOGGING ├───────────────────────────────┤
# One door for all messages: dunstify -> notify-send -> echo (stderr)
if command -v dunstify >/dev/null 2>&1; then
  NOTIFIER="dunstify"
elif command -v notify-send >/dev/null 2>&1; then
  NOTIFIER="notify-send"
else
  NOTIFIER=""
fi

_notify() { # _notify <urgency> <title> [body]
  local urgency="$1" title="$2" body="${3:-}"
  [[ -d $STATE_DIR ]] && printf '%(%F %T)T [%s] %s%s\n' -1 "$urgency" "$title" \
    "${body:+ - ${body//$'\n'/ | }}" 2>/dev/null >>"$LOG_FILE"
  if [[ -n $NOTIFIER ]] && "$NOTIFIER" -u "$urgency" "$title" "$body" 2>/dev/null; then
    return 0
  fi
  printf '[%s] %s%s\n' "$urgency" "$title" "${body:+ - $body}" >&2
}
log_info() { _notify low "$@"; }
log_warn() { _notify normal "$@"; }
log_err() { _notify critical "$@"; }
die() {
  log_err "$@"
  exit 1
}

# ├──────────────────────────────────┤ HELPER ├──────────────────────────────────┤
rofi_snippets() { rofi -theme "$ROFI_DIR/$ROFI_THEME_SNIPPETS" "$@"; }
rofi_wide() { rofi -theme "$ROFI_DIR/$ROFI_THEME_MENULEFT" "$@"; }
rofi_pass() { rofi_snippets -matching fuzzy -i -sort -sorting-method fzf "$@"; }

need_cmd() { # need_cmd <cmd> [hint]
  command -v "$1" >/dev/null 2>&1 || die "'$1' tidak ditemukan" "${2:-install dulu}"
}

as_root() {
  if [[ $EUID -eq 0 ]]; then
    "$@"
  elif [[ -t 0 ]]; then
    sudo "$@"
  elif command -v pkexec >/dev/null 2>&1; then
    pkexec "$@"
  else
    sudo -n "$@"
  fi
}

pkg_name() { # pkg_name <manager> <cmd>
  case "$2" in
  gpg) [[ $1 == dnf ]] && echo gnupg2 || echo gnupg ;;
  *) echo "$2" ;;
  esac
}

# Install whatever packages are missing (apt / pacman / dnf / zypper)
install_missing() { # install_missing <cmd>...
  local c pm="" missing=() pkgs=()
  for c in "$@"; do
    command -v "$c" >/dev/null 2>&1 || missing+=("$c")
  done
  ((${#missing[@]} == 0)) && return 0

  for pm in apt-get pacman dnf zypper; do
    command -v "$pm" >/dev/null 2>&1 && break
    pm=""
  done
  [[ -n $pm ]] || die "Package manager tidak dikenali" "install manual: ${missing[*]}"

  for c in "${missing[@]}"; do pkgs+=("$(pkg_name "$pm" "$c")"); done
  log_info "Install paket" "${pkgs[*]}"

  case "$pm" in
  apt-get) as_root apt-get install -y "${pkgs[@]}" ;;
  pacman) as_root pacman -S --needed --noconfirm "${pkgs[@]}" ;;
  dnf) as_root dnf install -y "${pkgs[@]}" ;;
  zypper) as_root zypper --non-interactive install "${pkgs[@]}" ;;
  esac || die "Install paket gagal" "${pkgs[*]}"

  for c in "${missing[@]}"; do need_cmd "$c"; done
}

# Figure out the WM: XDG_SESSION_DESKTOP -> DESKTOP_SESSION -> running processes
detect_wm() {
  local wm="${XDG_SESSION_DESKTOP:-${DESKTOP_SESSION:-}}"
  wm="${wm,,}"
  if [[ -z $wm ]]; then
    if pgrep -x bspwm >/dev/null 2>&1; then
      wm="bspwm"
    elif pgrep -x i3 >/dev/null 2>&1; then
      wm="i3"
    else
      wm="unknown"
    fi
  fi
  printf '%s' "$wm"
}

# Work out an 80% rectangle of the screen, centered (format WxH+X+Y)
calc_rect() {
  local w h ww wh
  read -r w h < <(xrandr --current | awk '/\*/ { split($1, a, "x"); print a[1], a[2]; exit }')
  [[ -n ${w:-} && -n ${h:-} ]] || return 1
  ww=$((w * 80 / 100))
  wh=$((h * 80 / 100))
  printf '%dx%d+%d+%d' "$ww" "$wh" $(((w - ww) / 2)) $(((h - wh) / 2))
}

# Run the command in a floating terminal (bspwm),
# otherwise just a normal terminal on other WMs
run_term_float() { # run_term_float <rect|""> cmd args...
  local rect="$1"
  shift
  local term="${TERMINAL:-xterm}" exec_flag=(-e)

  if [[ ${term##*/} == wezterm ]]; then
    term="wezterm"
    exec_flag=(start --)
  fi

  if [[ $(detect_wm) == *bspwm* ]] && command -v bspc >/dev/null 2>&1; then
    local rule=(state=floating)
    [[ -n $rect ]] && rule+=(center=true "rectangle=$rect")
    bspc rule -a '*' -o "${rule[@]}"
  fi
  "$term" "${exec_flag[@]}" "$@"
}

open_url() {
  local -a browser
  read -ra browser <<<"${NUBROWSER:-xdg-open}"
  setsid -f "${browser[@]}" "$1" >/dev/null 2>&1
}

resolve_git_repo() {
  [[ -n $PASS_GIT_REPO ]] && return 0

  # Grab it from the existing origin remote of the store
  if [[ -d $PASS_DIR/.git ]]; then
    PASS_GIT_REPO=$(git -C "$PASS_DIR" remote get-url origin 2>/dev/null) || PASS_GIT_REPO=""
    [[ -n $PASS_GIT_REPO ]] && return 0
  fi

  # Ask once, then save it
  PASS_GIT_REPO=$(printf '' | rofi_snippets -dmenu -i -p "Repo git pass (git@github.com:user/pass.git)") || return 1
  if [[ ! $PASS_GIT_REPO =~ ^(git@|ssh://|https://).+ ]]; then
    log_err "Repo tidak valid" "$PASS_GIT_REPO"
    PASS_GIT_REPO=""
    return 1
  fi

  mkdir -p "${CONFIG_FILE%/*}"
  printf ': "${PASS_GIT_REPO:=%q}"\n' "$PASS_GIT_REPO" >>"$CONFIG_FILE"
  log_info "Config disimpan" "$CONFIG_FILE"
}

# ┏╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍┓
# ╏                                   COMMANDS                                   ╏
# ┗╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍┛
# Format:
#   * Judul
#   [[https://url]]            (atau [[url][deskripsi]])
list_bookmarks() {
  awk '
    /^\*+[[:space:]]/ { title = $0; sub(/^\*+[[:space:]]+/, "", title); sub(/[[:space:]]*\[\[.*$/, "", title) }
    match($0, /\[\[[^]]+\]/) {
      url = substr($0, RSTART + 2, RLENGTH - 3)
      printf "%-40.40s  %s\n", (title != "" ? title : url), url
    }
  ' "$FILE_BOOKMARKED"
}

open_bookmark() {
  [[ -f $FILE_BOOKMARKED ]] || die "File bookmark tidak ditemukan" "$FILE_BOOKMARKED"

  local entry url
  entry=$(list_bookmarks | rofi_wide -dmenu -i -p "🔖 ") || return 0
  [[ -z $entry ]] && return 0

  url="${entry##* }"
  log_info "(BOOKMARK) Open URL:" "$url"
  open_url "$url"
}

edit_bookmark() {
  [[ -f $FILE_BOOKMARKED ]] || die "File bookmark tidak ditemukan" "$FILE_BOOKMARKED"
  local rect=""
  rect=$(calc_rect) || rect=""
  run_term_float "$rect" nvim "$FILE_BOOKMARKED"
}

# ├────────────────────────────────┤ GPG HELPER ├────────────────────────────────┤
gpg_id() { # key id/email from .gpg-id (first line)
  [[ -f $PASS_DIR/.gpg-id ]] && head -n1 "$PASS_DIR/.gpg-id" | tr -d '[:space:]'
}

primary_fpr() { # primary_fpr <id>
  gpg --list-keys --with-colons "$1" 2>/dev/null | awk -F: '$1 == "fpr" { print $10; exit }'
}

trust_ultimate() { printf '%s:6:\n' "$1" | gpg --import-ownertrust >/dev/null 2>&1; }

# "<fingerprint>  <uid>" for every secret key
gpg_list_secret() {
  gpg --list-secret-keys --with-colons 2>/dev/null | awk -F: '
    $1 == "sec" { want = 1; next }
    $1 == "fpr" && want { fpr = $10; want = 0; next }
    $1 == "uid" && fpr != "" { print fpr "  " $10; fpr = "" }'
}

# Newest backup file (Dropbox + repo), pattern: <name>-YYYY-MM-DD_<expired>.asc
latest_key_file() {
  {
    find "$PASS_KEY_DIR" -maxdepth 1 -type f -name '*-????-??-??_*.asc' -printf '%T@ %p\n' 2>/dev/null
    find "$PASS_DIR/$PASS_KEY_SUBDIR" -maxdepth 1 -type f -name '*-????-??-??_*.asc' -printf '%T@ %p\n' 2>/dev/null
  } | sort -nr | head -n1 | cut -d' ' -f2-
}

import_key_file() { # import_key_file <file>
  local out
  out=$(gpg --import "$1" 2>&1) || {
    log_err "Import GPG gagal" "$(tail -n 2 <<<"$out")"
    return 1
  }
  log_info "GPG" "key diimport dari ${1##*/}"
}

# Effective expiry of a key that can encrypt: "", "never", or an epoch.
# Subkeys die when the primary expires, so we use whichever comes first
# (primary vs subkey).
gpg_encrypt_expiry() { # gpg_encrypt_expiry <id>
  gpg --list-keys --with-colons "$1" 2>/dev/null | awk -F: '
    $1 == "pub" { pexp = ($7 == "" ? 0 : $7 + 0) }
    ($1 == "pub" || $1 == "sub") && $12 ~ /e/ && $2 != "r" {
      seen = 1
      own = ($7 == "" ? 0 : $7 + 0)
      eff = own
      if (own == 0) eff = pexp
      else if (pexp != 0 && pexp < own) eff = pexp
      if (eff == 0) never = 1
      else if (eff > best) best = eff
    }
    END { if (!seen) exit; if (never) print "never"; else print best }'
}

check_gpg_expiry() {
  local id exp now left
  id=$(gpg_id) || return 0
  exp=$(gpg_encrypt_expiry "$id")
  [[ -z $exp || $exp == never ]] && return 0

  now=$(date +%s)
  left=$(((exp - now) / 86400))
  if ((exp <= now)); then
    log_err "GPG key EXPIRED ($(date -d "@$exp" +%F))" "pass tidak bisa encrypt entry baru. Pakai menu Extend:GPG"
  elif ((left <= 30)); then
    log_warn "GPG key segera expired" "${left} hari lagi ($(date -d "@$exp" +%F)). Pakai menu Extend:GPG"
  fi
}

# The pinentry program used by gpg-agent:
# from gpg-agent.conf, or `pinentry` on PATH
# (gpgconf --list-options doesn't expose this option,
# so we read the config directly)
pinentry_program() {
  local conf p=""
  conf="$(gpgconf --list-dirs homedir 2>/dev/null)/gpg-agent.conf"
  [[ -f $conf ]] &&
    p=$(awk '$1 == "pinentry-program" { $1 = ""; sub(/^[[:space:]]+/, ""); v = $0 } END { print v }' "$conf")
  [[ -n $p ]] || p=$(command -v pinentry 2>/dev/null)
  [[ -n $p ]] && readlink -f "$p"
  return 0
}

# 0 = secret key is protected by a passphrase, 1 = NO passphrase, 2 = unknown
key_protection() { # key_protection <fpr>
  command -v gpg-connect-agent >/dev/null 2>&1 || return 2
  local -a grips
  local info g prot unknown=0
  mapfile -t grips < <(gpg --list-secret-keys --with-colons --with-keygrip "$1" 2>/dev/null |
    awk -F: '$1 == "grp" { print $10 }')
  ((${#grips[@]} > 0)) || return 2
  info=$(gpg-connect-agent 'KEYINFO --list' /bye 2>/dev/null)
  for g in "${grips[@]}"; do
    prot=$(awk -v g="$g" '$2 == "KEYINFO" && $3 == g { print $8; exit }' <<<"$info")
    case "$prot" in
    C) return 1 ;;
    P) ;;
    *) unknown=1 ;;
    esac
  done
  ((unknown)) && return 2
  return 0
}

# Generate a new GPG key just for pass:
# primary ed25519 (cert) + subkey cv25519 (encrypt)
# The passphrase is asked via pinentry
# (never through arguments or the command line)
create_gpg_key() { # create_gpg_key [--no-followup]
  need_cmd gpg
  local followup=1 name email expiry uid fpr out prot cand re revoc pin
  [[ ${1:-} == --no-followup ]] && followup=0

  pin=$(pinentry_program)
  if [[ -z $pin ]]; then
    log_warn "pinentry tidak ditemukan" "passphrase tidak bisa diminta dari rofi. Install pinentry-gtk2 / pinentry-qt"
  elif [[ ! -t 0 && ${pin##*/} =~ curses|tty ]]; then
    log_warn "pinentry berbasis terminal (${pin##*/})" "tidak bisa tampil dari rofi. Pakai pinentry grafis: set 'pinentry-program /usr/bin/pinentry-gtk-2' di ~/.gnupg/gpg-agent.conf lalu 'gpgconf --kill gpg-agent'"
  fi

  name=$(printf '%s\n' "pass-store" | rofi_snippets -dmenu -i -p "Nama key (khusus pass)") || return 0
  name="${name//[^[:alnum:] ._-]/}"
  name="${name#"${name%%[![:space:]]*}"}"
  name="${name%"${name##*[![:space:]]}"}"
  [[ -n $name ]] || {
    log_err "Buat key" "nama kosong / tidak valid"
    return 1
  }

  cand=$(git config --get user.email 2>/dev/null)
  email=$(printf '%s\n' ${cand:+"$cand"} "$USER@$(hostname)" | rofi_snippets -dmenu -i -p "Email key") || return 0
  email="${email//[[:space:]]/}"
  re='^[^@<>]+@[^@<>]+$'
  [[ $email =~ $re ]] || {
    log_err "Buat key" "email tidak valid: '$email'"
    return 1
  }

  expiry=$(printf '%s\n' 2y 1y 3y 5y 0 | rofi_snippets -dmenu -i -p "Masa berlaku key (0 = tanpa expired)") || return 0
  [[ $expiry =~ ^(0|[0-9]+[dwmy])$ ]] || {
    log_err "Buat key" "masa berlaku tidak valid: '$expiry'"
    return 1
  }

  uid="$name <$email>"
  if gpg --list-secret-keys "=$uid" >/dev/null 2>&1; then
    log_err "Buat key" "key dengan uid '$uid' sudah ada. Pakai nama/email lain"
    return 1
  fi

  log_warn "Buat key GPG baru" "$uid | ed25519 + cv25519 | expired: $expiry | passphrase diminta lewat pinentry (WAJIB diisi)"
  confirm_yes "Ya, buat key" "Buat key" || {
    log_info "Buat key" "dibatalkan"
    return 0
  }

  # --batch is REQUIRED: without it, gpg opens /dev/tty
  # (which isn't there when launched from rofi).
  # The passphrase is still asked via pinentry by gpg-agent,
  # not through arguments.
  out=$(gpg --batch --status-fd 1 --quick-generate-key "$uid" ed25519 cert "$expiry" 2>&1) || {
    log_err "Buat key gagal" "$(tail -n 2 <<<"$out")"
    return 1
  }
  fpr=$(awk '$2 == "KEY_CREATED" { print $4; exit }' <<<"$out")
  [[ -n $fpr ]] || {
    log_err "Buat key" "fingerprint tidak ditemukan di output gpg"
    return 1
  }

  out=$(gpg --batch --quick-add-key "$fpr" cv25519 encr "$expiry" 2>&1) || {
    log_err "Buat subkey enkripsi gagal" "key utama ${fpr: -16} sudah terbuat; hapus dengan: gpg --delete-secret-and-public-key $fpr | $(tail -n 1 <<<"$out")"
    return 1
  }

  key_protection "$fpr"
  prot=$?
  if ((prot == 1)); then
    log_err "Key dibuat TANPA passphrase" "secret key tidak terlindungi"
    if confirm_yes "Ya, set passphrase sekarang" "Passphrase"; then
      gpg --change-passphrase "$fpr" >/dev/null 2>&1
      key_protection "$fpr"
      prot=$?
    fi
    ((prot == 1)) && log_warn "Key masih tanpa passphrase" "salinan backup ke repo akan diblokir"
  fi

  log_info "Key GPG dibuat" "$uid | ${fpr: -16} | expired: $expiry"
  revoc="${GNUPGHOME:-$HOME/.gnupg}/openpgp-revocs.d/$fpr.rev"
  [[ -f $revoc ]] && log_info "Sertifikat revoke otomatis" "$revoc (simpan TERPISAH dari backup key)"

  backup_gpg "$fpr"

  ((followup)) || return 0
  if [[ ! -f $PASS_DIR/.gpg-id ]]; then
    log_info "Langkah berikut" "jalankan Setup:Pass agar store memakai key ini"
  elif [[ "$(store_primary_ids)" != "${fpr: -16}" ]]; then
    confirm_yes "Ya, migrasi store ke key ini sekarang (Rekey)" "Rekey pass" && rekey_pass "$fpr"
  fi
  return 0
}

# Export the secret key -> Dropbox (dated filename) -> copy it into the repo
backup_gpg() { # backup_gpg [fpr]  (no argument = key from .gpg-id)
  need_cmd gpg
  local fpr="${1:-}" meta created expiry uid name fname dest tmp prot
  if [[ -z $fpr ]]; then
    pass_ready || {
      log_err "Backup GPG" "$PASS_REASON"
      return 1
    }
    fpr=$(primary_fpr "$(gpg_id)")
  fi
  [[ -d $PASS_KEY_DIR ]] || {
    log_err "Folder backup tidak ada" "$PASS_KEY_DIR"
    return 1
  }

  key_protection "$fpr"
  prot=$?
  ((prot == 1)) &&
    log_err "Key TANPA passphrase" "backup tidak aman. Jalankan: gpg --change-passphrase ${fpr: -16}"
  meta=$(gpg --list-keys --with-colons "$fpr" 2>/dev/null)
  created=$(awk -F: '$1 == "pub" { print $6; exit }' <<<"$meta")
  expiry=$(awk -F: '$1 == "pub" { print $7; exit }' <<<"$meta")
  uid=$(awk -F: '$1 == "uid" { print $10; exit }' <<<"$meta")

  name="${uid%% (*}"
  name="${name%% <*}"
  name="${name,,}"
  name="${name//[^a-z0-9._-]/-}"
  [[ -n $name ]] || name="gpg-key"

  fname="${name}-$(date -d "@$created" +%F)_"
  if [[ -n $expiry ]]; then
    fname+="$(date -d "@$expiry" +%F).asc"
  else
    fname+="noexpiry.asc"
  fi
  dest="$PASS_KEY_DIR/$fname"

  if [[ -f $dest ]]; then
    log_info "Backup GPG" "sudah ada: $fname (tidak diekspor ulang)"
  else
    tmp=$(mktemp)
    if ! (umask 077 && gpg --armor --export-secret-keys "$fpr" >"$tmp" 2>/dev/null) ||
      ! grep -q 'BEGIN PGP PRIVATE KEY' "$tmp"; then
      rm -f "$tmp"
      log_err "Backup GPG gagal" "export dibatalkan / pinentry tidak tersedia"
      return 1
    fi
    install -m 600 "$tmp" "$dest" && rm -f "$tmp"
    log_info "Backup GPG" "disimpan: $dest"
  fi

  if [[ $PASS_KEY_IN_REPO == 1 ]]; then
    if ((prot == 1)); then
      log_err "Salinan ke repo DIBATALKAN" "key tanpa passphrase tidak boleh masuk repo (GitHub)"
    elif [[ ! -d $PASS_DIR/.git ]]; then
      log_info "Backup GPG" "repo belum ada, salinan ke repo dilewati (jalankan Backup:GPG lagi setelah Setup:Pass)"
    else
      mkdir -p "$PASS_DIR/$PASS_KEY_SUBDIR"
      install -m 600 "$dest" "$PASS_DIR/$PASS_KEY_SUBDIR/$fname"
      log_info "Backup GPG" "disalin ke repo: $PASS_KEY_SUBDIR/$fname. Jalankan Update:Pass untuk upload"
    fi
  fi
}

# Extend the key's expiry (primary + all subkeys), then back it up again
extend_gpg() {
  need_cmd gpg
  pass_ready || {
    log_err "Extend GPG" "$PASS_REASON"
    return 1
  }

  local fpr dur out
  fpr=$(primary_fpr "$(gpg_id)")
  dur=$(printf '%s\n' 1y 2y 3y 5y 0 | rofi_snippets -dmenu -i -p "Perpanjang GPG (0 = tanpa expired)") || return 0
  [[ -z $dur ]] && return 0
  [[ $dur =~ ^(0|[0-9]+[dwmy])$ ]] || {
    log_err "Extend GPG" "durasi tidak valid: $dur"
    return 1
  }

  out=$(gpg --quick-set-expire "$fpr" "$dur" 2>&1 && gpg --quick-set-expire "$fpr" "$dur" '*' 2>&1) || {
    log_err "Extend GPG gagal" "$(tail -n 2 <<<"$out")"
    return 1
  }
  log_info "Extend GPG" "masa berlaku diperbarui ($dur)"
  backup_gpg
}

# ├───────────────────────────────┤ PASS: SETUP ├─────────────────────────────┤
PASS_REASON=""
pass_ready() {
  PASS_REASON=""
  command -v pass >/dev/null 2>&1 || {
    PASS_REASON="pass belum terinstall"
    return 1
  }
  command -v gpg >/dev/null 2>&1 || {
    PASS_REASON="gpg belum terinstall"
    return 1
  }
  [[ -f $PASS_DIR/.gpg-id ]] || {
    PASS_REASON="store belum diinisialisasi ($PASS_DIR)"
    return 1
  }
  gpg --list-secret-keys "$(gpg_id)" >/dev/null 2>&1 ||
    {
      PASS_REASON="GPG secret key '$(gpg_id)' belum ada"
      return 1
    }
}

# Turn PASS_DIR into a git repo with origin remote = PASS_GIT_REPO
ensure_pass_repo() {
  resolve_git_repo || return 1

  local out
  if [[ -d $PASS_DIR/.git ]]; then
    git -C "$PASS_DIR" remote get-url origin >/dev/null 2>&1 ||
      git -C "$PASS_DIR" remote add origin "$PASS_GIT_REPO"
    return 0
  fi

  if [[ ! -d $PASS_DIR ]] || [[ -z $(ls -A "$PASS_DIR" 2>/dev/null) ]]; then
    out=$(git clone "$PASS_GIT_REPO" "$PASS_DIR" 2>&1) ||
      {
        log_err "git clone gagal" "$(tail -n 2 <<<"$out")"
        return 1
      }
    log_info "Setup pass" "repo di-clone ke $PASS_DIR"
    return 0
  fi

  # The local store exists but isn't a git repo yet
  git -C "$PASS_DIR" init -q -b main 2>/dev/null || git -C "$PASS_DIR" init -q
  git -C "$PASS_DIR" remote add origin "$PASS_GIT_REPO"
  log_warn "Setup pass" "$PASS_DIR dijadikan repo git. Jalankan Update:Pass untuk push pertama"
}

# Used when the key is already in .gpg-id but not in the keyring yet
# (new machine)
ensure_gpg_key() {
  local id fpr keyfile
  id=$(gpg_id)
  keyfile=$(latest_key_file)
  if gpg --list-secret-keys "$id" >/dev/null 2>&1; then
    # The key already exists: import the latest backup just to absorb
    # expiry/subkey updates (gpg never shortens expiry from an older backup)
    [[ -n $keyfile ]] && gpg --import "$keyfile" >/dev/null 2>&1
    log_info "GPG" "key '$id' sudah ada di keyring"
    return 0
  fi

  [[ -n $keyfile ]] || {
    log_err "GPG key '$id' tidak ada" "taruh file backup .asc di $PASS_KEY_DIR atau $PASS_DIR/$PASS_KEY_SUBDIR"
    return 1
  }
  import_key_file "$keyfile" || return 1
  fpr=$(primary_fpr "$id")
  [[ -n $fpr ]] && trust_ultimate "$fpr"
}

# New store (no .gpg-id yet): import / create a key, then run pass init
init_new_store() {
  local keyfile keys choice fpr

  if [[ -z $(gpg_list_secret) ]]; then
    keyfile=$(latest_key_file)
    if [[ -n $keyfile ]]; then
      import_key_file "$keyfile" || return 1
    else
      log_warn "GPG" "belum ada secret key, membuat key baru khusus pass"
      create_gpg_key --no-followup || return 1
    fi
  fi

  keys=$(gpg_list_secret)
  [[ -n $keys ]] || {
    log_err "GPG" "tidak ada secret key"
    return 1
  }

  choice=$(printf '%s\n' "$keys" | rofi_pass -dmenu -i -p "Pilih key untuk pass") || return 1
  fpr="${choice%% *}"
  [[ -n $fpr ]] || return 1

  trust_ultimate "$fpr"
  pass init "$fpr" >/dev/null 2>&1 || {
    log_err "pass init gagal" "$fpr"
    return 1
  }
  log_info "Setup pass" "store diinisialisasi dengan key $fpr"
}

setup_pass() {
  install_missing pass gpg git xclip
  ensure_pass_repo || return 1

  if [[ -f $PASS_DIR/.gpg-id ]]; then
    ensure_gpg_key || return 1
  else
    init_new_store || return 1
  fi

  check_gpg_expiry

  # Quick check: can the existing entries be opened with this keyring?
  audit_scan quick
  if ((AUDIT_TOTAL > 0 && ${#AUDIT_NOSECRET[@]} > 0)); then
    log_err "Setup pass: ${#AUDIT_NOSECRET[@]} dari $AUDIT_TOTAL entry TIDAK bisa dibuka" "secret key-nya tidak ada di keyring. Jalankan Audit:Pass"
  fi
  log_info "Setup pass" "selesai. Pakai Backup:GPG lalu Update:Pass untuk sinkron ke GitHub"
}

# ├────────────────────────────┤ PASS: UPDATE (GIT) ├────────────────────────────┤
git_pass() { # git_pass <deskripsi> <args git...>
  local desc="$1" out
  shift
  out=$(git -C "$PASS_DIR" "$@" 2>&1) || {
    log_err "$desc gagal" "$(tail -n 3 <<<"$out")"
    return 1
  }
}

update_pass() {
  need_cmd git
  resolve_git_repo || return 1

  [[ -d $PASS_DIR/.git ]] || {
    log_err "Update pass" "$PASS_DIR bukan repo git. Jalankan Setup:Pass dulu"
    return 1
  }

  local branch
  branch=$(git -C "$PASS_DIR" symbolic-ref --short HEAD 2>/dev/null) || branch="main"
  git -C "$PASS_DIR" remote get-url origin >/dev/null 2>&1 ||
    git -C "$PASS_DIR" remote add origin "$PASS_GIT_REPO"

  # 1) commit local changes (pass entries + key backup files)
  if [[ -n $(git -C "$PASS_DIR" status --porcelain) ]]; then
    git_pass "git add" add -A || return 1
    git_pass "git commit" commit -q -m "update $(hostname) $(date '+%F %T')" || return 1
  fi

  # 2) pull remote changes (if the branch already exists on the remote)
  if git -C "$PASS_DIR" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
    git_pass "git pull --rebase" pull --rebase --quiet origin "$branch" || {
      git -C "$PASS_DIR" rebase --abort >/dev/null 2>&1
      return 1
    }
  fi

  # 2b) .gpg-id differs from the remote -> ask for confirmation (swapping keys is a big change)
  if git -C "$PASS_DIR" rev-parse -q --verify "origin/$branch" >/dev/null 2>&1 &&
    [[ -n $(git -C "$PASS_DIR" diff --name-only "origin/$branch" HEAD -- .gpg-id 2>/dev/null) ]]; then
    log_warn "Update pass" ".gpg-id berubah dibanding remote (ganti key enkripsi)"
    confirm_yes "Ya, push perubahan .gpg-id" "Update pass" || {
      log_info "Update pass" "push dibatalkan"
      return 0
    }
  fi

  # 3) push
  git_pass "git push" push -q -u origin "$branch" || return 1
  log_info "Update pass" "tersinkron ke GitHub ($branch)"
}

# ├───────────────────────────┤ Pass: setup ydotool ├─────────────────────────┤
# Only called for actions that need ydotool (type/key)
ensure_ydotool() {
  need_cmd ydotool "sudo apt install ydotool"

  # Permissions for /dev/uinput (one-time, needs root + re-login)
  # https://github.com/ReimuNotMoe/ydotool/issues/25#issuecomment-535842993
  if [[ ! -w /dev/uinput ]]; then
    local udev_rule='KERNEL=="uinput", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"'
    if as_root bash -c '
        printf "%s\n" "$1" > /etc/udev/rules.d/80-uinput.rules &&
        udevadm control --reload-rules && udevadm trigger &&
        usermod -aG input "$2"' _ "$udev_rule" "$USER"; then
      log_warn "ydotool: izin input ditambahkan" "logout/login ulang lalu coba lagi"
    else
      die "ydotool: gagal set izin /dev/uinput"
    fi
    return 1
  fi

  local autostart="$HOME/.config/autostart/ydotoold.desktop"
  if [[ ! -f $autostart ]]; then
    mkdir -p "${autostart%/*}"
    cat >"$autostart" <<'EOF'
[Desktop Entry]
Type=Application
Terminal=false
Name=ydotool daemon
Exec=/usr/bin/ydotoold
Comment=Generic Linux command-line automation tool (no X!).
Categories=GNOME;GTK;System;
EOF
  fi

  if ! pgrep -x ydotoold >/dev/null 2>&1; then
    setsid -f ydotoold >/dev/null 2>&1
    sleep 0.3
  fi
}

# ├──────────────────────────────┤ Pass: actions ├────────────────────────────┤
# Grab a "key: value" field from `pass show` output (no extra newline)
get_field() { # get_field <data> <key>
  awk -v k="$2" 'index($0, k ": ") == 1 { print substr($0, length(k) + 3); exit }' <<<"$1"
}

clip_copy() { printf '%s' "$1" | xclip -selection clipboard; }

clip_copy_timed() {
  local secret="$1"
  clip_copy "$secret" || return 1
  (
    sleep "$CLIP_TIMEOUT"
    [[ $(xclip -o -selection clipboard 2>/dev/null) == "$secret" ]] && clip_copy ""
  ) >/dev/null 2>&1 &
  disown
}

key_tab() { ydotool key 15:1 15:0; }
key_enter() { ydotool key 28:1 28:0; }

pass_edit() {
  # shellcheck disable=SC2016
  run_term_float "" bash -c 'export EDITOR=nvim; echo "EDITOR=$EDITOR"; pass edit "$1"' _ "$1"
}

pass_action() { # pass_action <action> <entry>
  local action="$1" entry="$2" data user pw url

  # Decrypt first: missing entries / broken keys show up right away
  data=$(pass show "$entry" 2>/dev/null) || {
    log_err "Pass" "Entry '$entry' tidak ditemukan / gagal didekripsi"
    return 1
  }

  if [[ $action == edit ]]; then
    unset data # unused; don't keep the secret in memory
    pass_edit "$entry"
    return
  fi

  case "$action" in
  autoinput)
    user=$(get_field "$data" username)
    pw=$(get_field "$data" password)
    if [[ -z $user || -z $pw ]]; then
      log_err "[autoinput]" "username/password kosong"
      return 1
    fi
    ensure_ydotool || return 1
    sleep 0.3 # give rofi time to close and return focus
    ydotool type "$user" && key_tab && ydotool type "$pw" && key_enter
    ;;
  input_username)
    user=$(get_field "$data" username)
    [[ -n $user ]] || {
      log_err "[input username]" "username kosong"
      return 1
    }
    ensure_ydotool || return 1
    sleep 0.3
    ydotool type "$user" && key_enter
    ;;
  input_password)
    pw=$(get_field "$data" password)
    [[ -n $pw ]] || {
      log_err "[input password]" "password kosong"
      return 1
    }
    ensure_ydotool || return 1
    sleep 0.3
    ydotool type "$pw" && key_enter
    ;;
  copy_username)
    need_cmd xclip
    user=$(get_field "$data" username)
    [[ -n $user ]] || {
      log_err "[copy username]" "username kosong"
      return 1
    }
    clip_copy "$user" && log_info "username copied"
    ;;
  copy_password)
    need_cmd xclip
    pw=$(get_field "$data" password)
    [[ -n $pw ]] || {
      log_err "[copy password]" "password kosong"
      return 1
    }
    clip_copy_timed "$pw" && log_info "password copied" "dibersihkan dalam ${CLIP_TIMEOUT}s"
    ;;
  url)
    url=$(get_field "$data" url)
    [[ -n $url ]] || {
      log_err "[url]" "url kosong"
      return 1
    }
    open_url "$url"
    ;;
  esac
}

# ├────────────────────────────────┤ PASS: MENU ├────────────────────────────────┤
list_passwords() {
  find "$PASS_DIR" -path '*/.git' -prune -o -type f -name '*.gpg' -printf '%P\n' |
    sed 's/\.gpg$//'
}

list_pass_dirs() {
  find "$PASS_DIR" \( -path '*/.git' -o -path "$PASS_DIR/$PASS_KEY_SUBDIR" \) -prune -o -type d -printf '%P\n' |
    sed 's/^$/./'
}

select_command() { # select_command <entry>
  local entry="$1" choice action
  choice=$(printf '%s\n' "auto input" "input username" "input password" \
    "copy username" "copy password" "open url" "edit" |
    rofi_pass -dmenu -i -p "$entry") || return 0

  case "$choice" in
  "auto input") action="autoinput" ;;
  "input username") action="input_username" ;;
  "input password") action="input_password" ;;
  "copy username") action="copy_username" ;;
  "copy password") action="copy_password" ;;
  "open url") action="url" ;;
  "edit") action="edit" ;;
  *) return 0 ;;
  esac
  pass_action "$action" "$entry"
}

insert_pass() {
  local dir name entry
  dir=$(list_pass_dirs | rofi_pass -dmenu -i -p "select dir") || return 0
  [[ -z $dir ]] && return 0

  name=$(printf '' | rofi_snippets -dmenu -i -p "Create pass") || return 0
  [[ -z $name || $name == *..* || $name == /* ]] && {
    log_err "Create pass" "nama tidak valid: '$name'"
    return 1
  }

  [[ $dir == . ]] && entry="$name" || entry="$dir/$name"
  [[ -e "$PASS_DIR/$entry.gpg" ]] && die "Create pass" "'$entry' sudah ada"

  log_info "Creating new pass:" "$entry"
  pass_edit "$entry"
}

open_pass() {
  # Not ready yet -> announce why, offer setup (never auto-install without confirmation)
  if ! pass_ready; then
    log_warn "Pass belum siap" "$PASS_REASON"
    local ans
    ans=$(printf 'Ya, setup sekarang\nBatal\n' | rofi_snippets -dmenu -i -p "Setup pass?") || return 0
    [[ $ans == Ya* ]] || return 0
    setup_pass || return 1
    pass_ready || {
      log_err "Pass belum siap" "$PASS_REASON"
      return 1
    }
  fi
  check_gpg_expiry

  local choice entry
  choice=$(printf 'get pass\ninsert new pass\n' | rofi_pass -dmenu -i -p password) || return 0

  case "$choice" in
  "get pass")
    entry=$(list_passwords | rofi_pass -dmenu -i -p password) || return 0
    [[ -z $entry ]] && return 0
    select_command "$entry"
    ;;
  "insert new pass") insert_pass ;;
  esac
}

# ├───────────────────────┤ Audit (summarty + report) ├─────────────────────┤
declare -A KEY_PRIMARY=() KEY_UID=() KEY_STATUS=() KEY_SECRET=()
declare -A AUDIT_KEYCOUNT=()
AUDIT_TOTAL=0
AUDIT_STALE=()    # not encrypted to the target key (.gpg-id / new key)
AUDIT_NOSECRET=() # no secret key in the keyring -> CANNOT be opened
AUDIT_DECFAIL=()  # secret key exists but decryption failed (deep mode)
AUDIT_UNKNOWN=()  # unrecognized file format

confirm_yes() { # confirm_yes <yes-label> [prompt]  ("Cancel" in the first slot = safe default)
  local ans
  ans=$(printf 'Batal\n%s\n' "$1" | rofi_snippets -dmenu -i -p "${2:-Konfirmasi}") || return 1
  [[ $ans == "$1" ]]
}

# Map keyid (primary + subkey) -> primary, owner, status, secret-key presence
load_keymap() {
  KEY_PRIMARY=() KEY_UID=() KEY_STATUS=() KEY_SECRET=()
  local secret_ids keyid primary valid exp uid now status
  now=$(date +%s)
  secret_ids=" $(gpg --list-secret-keys --with-colons 2>/dev/null |
    awk -F: '($1 == "sec" || $1 == "ssb") && $15 != "#" { printf "%s ", $5 }') "

  while IFS='|' read -r keyid primary valid exp uid; do
    [[ -n $keyid ]] || continue
    KEY_PRIMARY[$keyid]="$primary"
    KEY_UID[$keyid]="$uid"
    status="ok"
    if [[ $valid == r ]]; then
      status="REVOKED"
    elif [[ $valid == d ]]; then
      status="DISABLED"
    elif [[ $valid == e ]] || [[ $exp != 0 && $exp -le $now ]]; then
      status="EXPIRED"
    fi
    KEY_STATUS[$keyid]="$status"
    if [[ $secret_ids == *" $keyid "* ]]; then KEY_SECRET[$keyid]="ya"; else KEY_SECRET[$keyid]="tidak"; fi
  done < <(gpg --list-keys --with-colons 2>/dev/null | awk -F: '
    $1 == "pub" { pk = $5; pv = $2; pe = ($7 == "" ? 0 : $7 + 0); puid = "-"; pend = 1; next }
    $1 == "uid" && pend { puid = ($10 == "" ? "-" : $10); pend = 0
      print pk "|" pk "|" (pv == "" ? "-" : pv) "|" pe "|" puid; next }
    $1 == "sub" {
      se = ($7 == "" ? 0 : $7 + 0); eff = se
      if (se == 0) eff = pe; else if (pe != 0 && pe < se) eff = pe
      v = ($2 == "" ? "-" : $2); if (pv == "r" || pv == "e" || pv == "d") v = pv
      print $5 "|" pk "|" v "|" eff "|" puid }')
}

# 16-hex primary keyid from each line of .gpg-id
store_primary_ids() {
  local id fpr
  [[ -f $PASS_DIR/.gpg-id ]] || return 0
  while IFS= read -r id; do
    id="${id%%#*}"
    id="${id//[[:space:]]/}"
    [[ -n $id ]] || continue
    fpr=$(primary_fpr "$id")
    [[ -n $fpr ]] && printf '%s\n' "${fpr: -16}"
  done <"$PASS_DIR/.gpg-id"
}

# Encryption recipients of a file (no decryption, no pinentry)
entry_recipients() { # entry_recipients <file.gpg>
  gpg --batch --list-only --status-fd 1 --decrypt "$1" 2>/dev/null | awk '$2 == "ENC_TO" { print $3 }'
}

# Scan the whole store -> fill in the AUDIT_* variables
audit_scan() { # audit_scan <quick|deep> [keyid-primary-target...]
  local mode="${1:-quick}" f rel id p primaries current has_secret
  local -a ids
  AUDIT_TOTAL=0
  AUDIT_STALE=()
  AUDIT_NOSECRET=()
  AUDIT_DECFAIL=()
  AUDIT_UNKNOWN=()
  AUDIT_KEYCOUNT=()

  load_keymap
  if [[ -n ${2:-} ]]; then
    primaries=" ${*:2} "
  else
    primaries=" $(store_primary_ids | tr '\n' ' ') "
  fi

  while IFS= read -r -d '' f; do
    rel="${f#"$PASS_DIR"/}"
    rel="${rel%.gpg}"
    ((AUDIT_TOTAL++))

    mapfile -t ids < <(entry_recipients "$f")
    if ((${#ids[@]} == 0)); then
      AUDIT_UNKNOWN+=("$rel")
      continue
    fi

    current=0
    has_secret=0
    for id in "${ids[@]}"; do
      AUDIT_KEYCOUNT[$id]=$((${AUDIT_KEYCOUNT[$id]:-0} + 1))
      p="${KEY_PRIMARY[$id]:-}"
      [[ -n $p && $primaries == *" $p "* ]] && current=1
      [[ ${KEY_SECRET[$id]:-tidak} == ya ]] && has_secret=1
    done

    ((current)) || AUDIT_STALE+=("$rel")
    if ((! has_secret)); then
      AUDIT_NOSECRET+=("$rel")
    elif [[ $mode == deep ]]; then
      gpg --batch --quiet --decrypt "$f" >/dev/null 2>&1 || AUDIT_DECFAIL+=("$rel")
    fi
  done < <(find "$PASS_DIR" -path '*/.git' -prune -o -type f -name '*.gpg' -print0)
}

_report_list() { # _report_list <title> <item>...
  local title="$1" n i max=100
  shift
  n=$#
  ((n == 0)) && return 0
  printf '\n%s (%d):\n' "$title" "$n"
  for ((i = 1; i <= n && i <= max; i++)); do printf '  - %s\n' "${!i}"; done
  ((n > max)) && printf '  ... +%d lagi\n' $((n - max))
  return 0
}

audit_report() { # audit_report <mode>  -> stdout
  local mode="$1" id ok
  ok=$((AUDIT_TOTAL - ${#AUDIT_STALE[@]} - ${#AUDIT_UNKNOWN[@]}))

  printf 'Audit pass - %(%F %T)T (mode: %s)\n' -1 "$mode"
  printf 'Store    : %s\n' "$PASS_DIR"
  printf '.gpg-id  : %s\n' "$(paste -sd' ' "$PASS_DIR/.gpg-id" 2>/dev/null || echo '-')"
  printf 'Entry    : %d\n\n' "$AUDIT_TOTAL"

  printf '%-18s %6s  %-6s %-14s %s\n' 'RECIPIENT KEY' 'ENTRY' 'SECRET' 'STATUS' 'PEMILIK'
  for id in "${!AUDIT_KEYCOUNT[@]}"; do
    if [[ -n ${KEY_PRIMARY[$id]:-} ]]; then
      printf '%-18s %6d  %-6s %-14s %s\n' "$id" "${AUDIT_KEYCOUNT[$id]}" \
        "${KEY_SECRET[$id]}" "${KEY_STATUS[$id]}" "${KEY_UID[$id]}"
    else
      printf '%-18s %6d  %-6s %-14s %s\n' "$id" "${AUDIT_KEYCOUNT[$id]}" \
        "tidak" "TIDAK DIKENAL" "(tidak ada di keyring)"
    fi
  done | sort -k2,2nr

  printf '\nRINGKASAN\n'
  printf '  Sesuai key target (.gpg-id)      : %d\n' "$ok"
  printf '  Tidak sesuai key target          : %d\n' "${#AUDIT_STALE[@]}"
  printf '  Tanpa secret key (tidak bisa buka): %d\n' "${#AUDIT_NOSECRET[@]}"
  if [[ $mode == deep ]]; then
    printf '  Gagal dekripsi                   : %d\n' "${#AUDIT_DECFAIL[@]}"
  else
    printf '  Gagal dekripsi                   : - (jalankan mode deep)\n'
  fi
  printf '  Format tidak dikenali            : %d\n' "${#AUDIT_UNKNOWN[@]}"

  _report_list "Tanpa secret key" "${AUDIT_NOSECRET[@]}"
  _report_list "Gagal dekripsi" "${AUDIT_DECFAIL[@]}"
  _report_list "Tidak sesuai key target" "${AUDIT_STALE[@]}"
  _report_list "Format tidak dikenali" "${AUDIT_UNKNOWN[@]}"
}

audit_pass() { # audit_pass [quick|deep]
  local mode="${1:-quick}" report ok nos dec stale unk summary
  need_cmd gpg
  [[ -d $PASS_DIR ]] || die "Password store tidak ditemukan" "$PASS_DIR"

  log_info "Audit pass" "memeriksa entry (mode $mode)..."
  audit_scan "$mode"

  report="$REPORT_DIR/audit-$(date +%Y%m%d-%H%M%S).txt"
  (umask 077 && audit_report "$mode" >"$report")

  stale=${#AUDIT_STALE[@]} nos=${#AUDIT_NOSECRET[@]} dec=${#AUDIT_DECFAIL[@]} unk=${#AUDIT_UNKNOWN[@]}
  ok=$((AUDIT_TOTAL - stale - unk))
  summary="total $AUDIT_TOTAL | sesuai $ok | tidak sesuai $stale | tanpa secret $nos | gagal dekripsi $dec"

  if ((nos + dec > 0)); then
    log_err "Audit pass: ada entry yang TIDAK bisa dibuka" "$summary"
  elif ((stale + unk > 0)); then
    log_warn "Audit pass: key tidak seragam" "$summary"
  else
    log_info "Audit pass: semua OK" "$summary"
  fi
  log_info "Laporan audit" "$report"

  find "$REPORT_DIR" -name 'audit-*.txt' -mtime +30 -delete 2>/dev/null
  rofi_wide -dmenu -i -p "Audit ($mode)" <"$report" >/dev/null || true
}

view_log() {
  [[ -f $LOG_FILE ]] || {
    log_info "Log" "belum ada log"
    return 0
  }
  tac "$LOG_FILE" | head -n 300 | rofi_wide -dmenu -i -p "log" >/dev/null || true
}

# ├────────────────────────┤ REKEY: OLD KEY -> NEW BARU ├────────────────────────┤
# Same check `pass init` will run into (expired/revoked/disabled -> fails)
key_usable_for_encrypt() { # key_usable_for_encrypt <fpr>
  trust_ultimate "$1"
  printf 'x' | gpg --batch --yes --encrypt --recipient "$1" --output /dev/null 2>/dev/null
}

snapshot_store() { # -> path tarball
  local tarball
  tarball="$BACKUP_DIR/password-store-$(date +%Y%m%d-%H%M%S)-$RANDOM.tar.gz"
  (umask 077 && tar -C "$(dirname "$PASS_DIR")" -czf "$tarball" "$(basename "$PASS_DIR")") || return 1
  printf '%s' "$tarball"
}

rekey_rollback() { # rekey_rollback <git-tag|""> <tarball>
  if [[ -n $1 ]] && git -C "$PASS_DIR" reset -q --hard "$1" 2>/dev/null; then
    log_warn "Rollback" "store dikembalikan ke tag $1"
  elif [[ -f $2 ]] && tar -C "$(dirname "$PASS_DIR")" -xzf "$2"; then
    log_warn "Rollback" "store dipulihkan dari $2"
  else
    log_err "Rollback GAGAL" "pulihkan manual dari: $2"
  fi
}

# Re-encrypt the whole store to the new key, with checks before and after
rekey_pass() {
  need_cmd gpg
  need_cmd pass
  [[ -f $PASS_DIR/.gpg-id ]] || die "Rekey pass" "store belum diinisialisasi. Jalankan Setup:Pass"

  local keys choice fpr new_primary e out msg tag="" tarball
  local -a movable=() regress=()
  local -A bad_before=()

  fpr="${1:-}" # optional: fingerprint of the new key (from create_gpg_key)
  if [[ -z $fpr ]]; then
    keys=$(gpg_list_secret)
    [[ -n $keys ]] || die "Rekey pass" "tidak ada secret key di keyring"
    choice=$(printf '%s\n' "$keys" | rofi_pass -dmenu -i -p "Key BARU untuk pass") || return 0
    fpr="${choice%% *}"
  fi
  [[ -n $fpr ]] || return 0
  new_primary="${fpr: -16}"

  if ! key_usable_for_encrypt "$fpr"; then
    log_err "Rekey dibatalkan" "key $new_primary tidak bisa dipakai enkripsi (expired/revoked/disabled)"
    return 1
  fi

  # 1) Pre-check: which entries can still be opened with this keyring?
  log_info "Rekey pass" "memeriksa semua entry sebelum migrasi..."
  audit_scan deep "$new_primary"
  for e in "${AUDIT_NOSECRET[@]}" "${AUDIT_DECFAIL[@]}" "${AUDIT_UNKNOWN[@]}"; do bad_before[$e]=1; done
  for e in "${AUDIT_STALE[@]}"; do
    [[ -z ${bad_before[$e]:-} ]] && movable+=("$e")
  done

  if ((${#movable[@]} == 0)) && [[ "$(store_primary_ids)" == "$new_primary" ]]; then
    log_info "Rekey pass" "tidak ada yang perlu dimigrasi (semua sudah memakai key $new_primary)"
    return 0
  fi

  msg="${#movable[@]} entry dimigrasi ke key $new_primary"
  ((${#bad_before[@]})) &&
    msg+=" | ${#bad_before[@]} entry TIDAK bisa dibuka & tetap di key lama (import key lamanya lalu ulangi)"
  log_warn "Rekey pass: rencana" "$msg"
  confirm_yes "Ya, migrasi sekarang" "Rekey pass" || {
    log_info "Rekey pass" "dibatalkan"
    return 0
  }

  # 2) Safety net: tarball snapshot + git tag
  tarball=$(snapshot_store) || die "Rekey pass" "gagal membuat snapshot"
  log_info "Rekey pass" "snapshot: $tarball"
  if [[ -d $PASS_DIR/.git ]]; then
    if [[ -n $(git -C "$PASS_DIR" status --porcelain) ]]; then
      git_pass "git add" add -A && git_pass "git commit" commit -q -m "pre-rekey snapshot" || return 1
    fi
    tag="pre-rekey-$(date +%Y%m%d-%H%M%S)-$RANDOM"
    git_pass "git tag" tag "$tag" || return 1
  fi

  # 3) Execution
  out=$(pass init "$fpr" 2>&1)
  (umask 077 && printf '%s\n' "$out" >"$STATE_DIR/rekey-last.log")

  # 4) Verify: no new broken entries allowed
  log_info "Rekey pass" "memverifikasi hasil..."
  audit_scan deep "$new_primary"
  for e in "${AUDIT_STALE[@]}" "${AUDIT_NOSECRET[@]}" "${AUDIT_DECFAIL[@]}" "${AUDIT_UNKNOWN[@]}"; do
    [[ -z ${bad_before[$e]:-} ]] && regress+=("$e")
  done
  [[ "$(store_primary_ids)" == "$new_primary" ]] || regress+=(".gpg-id")

  if ((${#regress[@]} > 0)); then
    log_err "Rekey GAGAL verifikasi" "${#regress[@]} masalah baru (contoh: ${regress[0]}). Rollback otomatis. Detail: $STATE_DIR/rekey-last.log"
    rekey_rollback "$tag" "$tarball"
    return 1
  fi

  log_info "Rekey pass selesai" "${#movable[@]} entry dimigrasi ke key $new_primary. Rollback: ${tag:-tarball $tarball}"
  backup_gpg
  log_info "Rekey pass" "jalankan Update:Pass untuk upload. Riwayat git masih menyimpan file lama (terenkripsi key lama)"
}

# ┏╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍┓
# ╏                                     Main                                     ╏
# ┗╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍┛
rotate_log() { # keep ops.log from growing (>512 KB -> keep the last 1000 lines)
  [[ -f $LOG_FILE ]] || return 0
  (($(stat -c %s "$LOG_FILE") > 524288)) || return 0
  tail -n 1000 "$LOG_FILE" >"$LOG_FILE.tmp" && mv "$LOG_FILE.tmp" "$LOG_FILE"
}

main() {
  need_cmd rofi
  rotate_log

  local choice
  choice=$(printf 'Open:Bookmarked\nOpen:Pass\nEdit:Bookmarked\nSetup:Pass\nUpdate:Pass\nBackup:GPG\nExtend:GPG\nCreate:GPG\nAudit:Pass\nAudit:Pass-Deep\nRekey:Pass\nView:Log\n' |
    rofi_snippets -dmenu -i -sorting-method fzf -p " Menu:") || exit 0

  case "$choice" in
  "Open:Bookmarked") open_bookmark ;;
  "Edit:Bookmarked") edit_bookmark ;;
  "Open:Pass") open_pass ;;
  "Setup:Pass") setup_pass ;;
  "Update:Pass") update_pass ;;
  "Backup:GPG") backup_gpg ;;
  "Extend:GPG") extend_gpg ;;
  "Create:GPG") create_gpg_key ;;
  "Audit:Pass") audit_pass quick ;;
  "Audit:Pass-Deep") audit_pass deep ;;
  "Rekey:Pass") rekey_pass ;;
  "View:Log") view_log ;;
  esac
}

# Only runs when executed directly (can be sourced for testing)
[[ ${BASH_SOURCE[0]} == "$0" ]] && main "$@"
