#!/bin/bash

WALLI3IMG="$HOME/moxconf/media_and_tuts/walli3"

#####################################

# > TAK PERLU OTAK ATIK KODE DI BAWAH

#####################################

numberPath="$HOME/.cache/wallpaper"
numberFile="imgWall"

set_wallpaper_with_gowall() {
  if command -v gowall >/dev/null 2>&1; then
    gowall convert "$1" -t "$2" --output /tmp/newName.jpg >/dev/null
    feh --bg-scale /tmp/newName.jpg
  else
    feh --bg-scale "$1"
  fi
}

main() {
  local set_theme="general"
  if [[ -n "$1" ]]; then
    set_theme="$1"
  fi

  [[ ! -d $WALLI3IMG ]] && dunstify "Fehbg: path walli3=$WALLI3IMG not found!" && exit 1

  pathNumber="$numberPath/$numberFile"

  mkdir -p "$numberPath"
  [[ ! -f "$pathNumber" ]] && echo "0" >"$pathNumber"

  array=()
  while IFS= read -r -d $'\0'; do
    array+=("$REPLY")
  done < <(find "$WALLI3IMG" -type f -print0 | sort -z)

  totalNumImg=${#array[@]}

  if ((totalNumImg == 0)); then
    dunstify "Fehbg: tidak ada gambar di $WALLI3IMG"
    exit 1
  fi

  numImg="$(cat "$pathNumber")"

  [[ ! "$numImg" =~ ^[0-9]+$ ]] && numImg=0
  ((numImg >= totalNumImg)) && numImg=0

  local idx=$numImg

  local nextNum=$(((idx + 1) % totalNumImg))
  echo "$nextNum" >"$pathNumber"

  if [[ $set_theme == "general" ]]; then
    path_nvim="$HOME/.config/nvim/lua/r/config/init.lua"
    if [[ -f $path_nvim ]]; then
      colorscheme=$(grep -i "local colorscheme" <"$path_nvim" | cut -d'=' -f2 | xargs)
      if [[ -n "$colorscheme" ]]; then
        set_wallpaper_with_gowall "${array[$idx]}" "$colorscheme"
      else
        feh --bg-scale "${array[$idx]}"
      fi
    else
      feh --bg-scale "${array[$idx]}"
    fi
  else
    set_wallpaper_with_gowall "${array[$idx]}" "$set_theme"
  fi

  echo "${array[$idx]}" >/tmp/bg-windows
}

main "$@"
