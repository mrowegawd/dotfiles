  " pomodoro: 30 minute|pomodoro_30minute_mode"
  " pomodoro: 25 minute|pomodoro_25minute_mode"
  " pomodoro: 5 minute|pomodoro_5minute_mode"
  "󰭲 rkill|open_rkill"
  " multilog|open_mutlilog"
  "󰎕 News RSS|open_newsboat"
  " Tock|open_tock"
)

callme() {
  local selected item
  local -a cmd

  selected=$(printf '%s\n' "${MENU_ITEMS[@]%%|*}" |
    _fzf_center 30% 55% --prompt="⚡" --border-label ' ALT-Y ')
  [[ -z $selected ]] && return 0

  for item in "${MENU_ITEMS[@]}"; do
    if [[ ${item%%|*} == "$selected" ]]; then
      read -ra cmd <<<"${item#*|}"
      "${cmd[@]}"
      return
    fi
  done
}

if [[ $# -gt 0 ]]; then
  if declare -F "$1" >/dev/null; then
    "$@"
  else
    echo "unknown function: $1" >&2
    exit 127
  fi
fi
