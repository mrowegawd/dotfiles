  " tmux: select session|tmux_select_sess"
  " tmux: break pane|tmux_break_pane"
  " tmux: search URL|open_url"
  " tmux: rename window|tmux_rename_window"
  " tmux: open snippets|open_snippets"
  " tmux: capture pane|capture_pane"
