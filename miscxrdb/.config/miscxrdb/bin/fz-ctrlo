}

open_notes() {
  _require_tmux
  _toggle_popup tmp_notes_wiki 85% 90% nvim "$HOME/Dropbox/neorg" 80% 80%
}

open_snippets() {
  bash "$BIN_DIR/snippet"
}

capture_pane_and_save_to_file() {
  _require_shell_pane "Capture pane"
  tmux command-prompt -p 'save history to filename:' -I "$HOME/Downloads/tmux.history" \
    'capture-pane -S -32768 ; save-buffer %1 ; delete-buffer'
}

capture_pane() {
  _require_shell_pane "Capture pane"
  local file="$HOME/Downloads/tmux.history"
  tmux capture-pane -p -S -32768 >"$file"
  tmux send-keys "nvim $file" Enter
}

capture_fzf() {
  local choice
  choice=$(printf '%s\n' "Capture pane and save to file" "Capture pane" |
    _fzf_center 30% 20% --prompt="Tmux> ")

  case $choice in
  "Capture pane and save to file") capture_pane_and_save_to_file ;;
  "Capture pane") capture_pane ;;
  esac
}

#  +----------------------------------------------------------+
#  |                           TMUX                           |
#  +----------------------------------------------------------+

tmux_clock_mode() {
  local json="/tmp/tmux-main-layout-workspaces.json"
  if [[ ! -f $json ]]; then
    dunstify "Create base layout first"
    exit 1
  fi

  if ! command -v tclock >/dev/null 2>&1; then
    tmux clock-mode
    return
  fi

  local session window main_pane fm_pane split_pane tclock_cmd
  local -a ids=()

  IFS=$'\t' read -r session window < <(tmux display-message -p $'#S\t#I')

  mapfile -t ids < <(jq -r --arg s "$session" --arg w "$window" \
    '.[$s][$w] | (.main_pane_id // ""), (.file_manager_pane_id // "")' "$json")
  main_pane=${ids[0]:-}
  fm_pane=${ids[1]:-}

  if [[ -z $fm_pane ]]; then
    dunstify "Pane file manager is empty?"
    exit 1
  fi

  case ${1:-} in
  clock) tclock_cmd='tclock clock -S' ;;
  pomodoro) tclock_cmd='tclock -c red timer -d 25m -M' ;;
  *) tclock_cmd='' ;;
  esac

  split_pane=$(tmux split-pane -v -p 25 -l 10 -c "$PANE_PATH_FMT" -t "$fm_pane" -P -F '#{pane_id}')

  [[ -n $main_pane ]] && tmux select-pane -t "$main_pane"

  _wait_pane_ready "$split_pane"
  [[ -n $tclock_cmd ]] && tmux send-keys -t "$split_pane" "$tclock_cmd" Enter
}

tmux_open_clock() {
  _tm_toggle_pane clock_mode
}

tmux_toggle_status() {
  tmux set-option -g status
  if [[ $(tmux show-options -gv status) == off ]]; then
    tmux set-option -g pane-border-status off
  else
    tmux set-option -g pane-border-status top
  fi
}

tmux_toggle_synchronize_panes() {
  if [[ $(tmux display-message -p '#{pane_synchronized}') == 1 ]]; then
    tmux set-window-option synchronize-panes off \; display 'Synchronize End!'
  else
    tmux set-window-option synchronize-panes on \; display 'Synchronize Begin Now!'
  fi
}

tmux_select_sess() {
  local sess
  sess=$(tmux list-sessions -F "#{session_name}" 2>/dev/null |
    _fzf_center 50% 40% --exit-0 --prompt="Select Session> ")
  [[ -z $sess ]] && return 0

  tmux switch-client -t "$sess"
}

tmux_create_sess() {
  local marked="$HOME/Dropbox/data.programming.forprivate/marked-pwd"
  local dir name

  dir=$(_fzf_center 50% 40% --prompt='Create New Session> ' <"$marked")
  [[ -z $dir ]] && return 0

  if [[ ! -d $dir ]]; then
    notify-send "Path: $dir" "Not found!"
    exit 1
  fi

  name=$(basename "$dir")
  name=${name//./_}

  _is_session_exists "$name" || tmux new-session -d -s "$name" -c "$dir"

  tmux switch-client -t "$name"
  notify-send "create new session and detach --> $name"
}

tmux_kill_others_pane() {
  tmux kill-pane -a
}

tmux_reset_workspaces() {
  _tm_toggle_pane reset_pane_workspaces
}

tmux_clear_main_id_workspace() {
  rm -f /tmp/tmux-main-layout-*
  tmux_kill_others_pane

  dunstify "Cleared tmux main IDs and panes"
}

tmux_break_pane() {
  tmux break-pane
}

tmux_lock_input() {
  tmux select-pane -T "Toggle Input" \; if-shell -F "#{pane_input_off}" "select-pane -e" "select-pane -d"
}

tmux_lock_pane_size() {
  # bind -r x  run-shell 'tmux set -g @resize-locked 1; ...'   (lock)
  # bind -r X  run-shell 'tmux set -g @resize-locked 0; ...'   (unlock)
  tmux set -g @resize-locked 1
}

tmux_rename_window() {
  tmux command-prompt -I "/#{window_name}/" "rename-window '%%'"
}

tmux_disable_auto_resize_workspaces() {
  _tm_toggle_pane toggle_disable_auto_resize_pane
}

