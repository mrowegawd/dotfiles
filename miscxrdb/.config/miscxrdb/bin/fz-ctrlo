#!/bin/bash

set -uo pipefail

# ╭──────────────────────────────────────────────────────────╮
# │                          utils                           │
# ╰──────────────────────────────────────────────────────────╯

readonly TMUX_SNAPSHOT_PATH="$HOME/.config/tmuxconfig/themes/tmux-snapshot"
readonly BIN_DIR="$HOME/.config/miscxrdb/bin"
readonly PANE_PATH_FMT='#{pane_current_path}'
readonly SHELL_NAME="zsh"

COL_TAB_ACTIVE_FG=""
COL_BG=""
COL_RED=""
_COLORS_READY=0

_init_colors() {
  ((_COLORS_READY)) && return 0
  _COLORS_READY=1

  local -a x=() s=()

  mapfile -t x < <(xrdb -query 2>/dev/null | awk '
    {
      n = index($0, ":"); if (!n) next
      k = substr($0, 1, n - 1); sub(/.*[*.]/, "", k); k = tolower(k)
      v = substr($0, n + 1);    gsub(/^[ \t]+|[ \t]+$/, "", v)
      if      (k == "color16"    && !a) a = v
      else if (k == "background" && !b) b = v
      else if (k == "color9"     && !c) c = v
    }
    END { print a; print b; print c }')
  COL_TAB_ACTIVE_FG=${x[0]:-}
  COL_BG=${x[1]:-}
  COL_RED=${x[2]:-}

  if [[ -f $TMUX_SNAPSHOT_PATH ]]; then
    mapfile -t s < <(awk -F= '
      { u = toupper($0) }
      !b && u ~ /STATUSLINE_BG/ { b = $2; gsub(/"/, "", b) }
      !r && u ~ /RED/           { r = $2; gsub(/"/, "", r) }
      END { print b; print r }' "$TMUX_SNAPSHOT_PATH")
    if [[ -n ${s[0]:-} ]]; then COL_BG=${s[0]}; fi
    if [[ -n ${s[1]:-} ]]; then COL_RED=${s[1]}; fi
  fi
}

_tmux_error_msg() {
  _init_colors
  tmux display-message "#[fill=$COL_RED bg=$COL_RED fg=$COL_BG bold align=left] $1"
}

not_in_tmux() {
  [[ -z ${TMUX:-} ]]
}

_require_tmux() {
  if not_in_tmux; then
    echo "${1:-[+] can not run, you are not in tmux mode}"
    exit 1
  fi
}

is_vim() {
  [[ $(tmux display-message -p '#{pane_current_command}') =~ (n?vim|view|gvim) ]]
}

# _pane_cmd_is <cmd name>
_pane_cmd_is() {
  [[ $(tmux display-message -p '#{pane_current_command}') == "$1" ]]
}

_require_shell_pane() {
  if ! _pane_cmd_is "$SHELL_NAME"; then
    dunstify "[!] $1" "Need to run inside $SHELL_NAME!"
    exit 1
  fi
}

_is_session_exists() {
  tmux has-session -t "=$1" 2>/dev/null
}

# fzf helpers ──
# _fzf_center <w> <h> [fzf args...]   (stdin -> stdout)
_fzf_center() {
  local w=$1 h=$2
  shift 2
  fzf-tmux -xC -w "$w" -h "$h" "$@"
}

# _fzf_pick <nama @option tmux> <prompt>   (stdin -> stdout)
_fzf_pick() {
  local user_opts
  local -a opts
  user_opts=$(tmux show -gqv "$1")
  if [[ -n $user_opts ]]; then
    eval "opts=($user_opts)"
  else
    opts=(-w 70% -h 50% --multi -0 --no-preview --bind alt-a:toggle-all --prompt "$2")
  fi
  fzf-tmux "${opts[@]}"
}

# ── capture pane ──
_capture_pane_text() {
  local lines=${1:-32768}
  [[ $lines == screen ]] && lines=32768
  tmux capture-pane -J -p -S "-$lines"
}

_wait_pane_ready() {
  local pane=$1 out i
  for ((i = 0; i < 20; i++)); do
    out=$(tmux capture-pane -p -t "$pane")
    [[ $out =~ [^[:space:]] ]] && return 0
    sleep 0.05
  done
  return 1
}

_clipboard_paste() {
  if command -v wl-paste >/dev/null 2>&1; then
    wl-paste
  elif command -v xclip >/dev/null 2>&1; then
    xclip -o -selection clipboard
  elif command -v xsel >/dev/null 2>&1; then
    xsel --clipboard --output
  fi
}

_popup_run() {
  local w=$1 h=$2 dir=$3 x=$4 y=$5 cmd=$6
  _init_colors
  local -a args=(-w "$w" -h "$h" -d "$dir" -S "bg=$COL_BG,fg=$COL_TAB_ACTIVE_FG" -b rounded -EE)
  [[ -n $x ]] && args+=(-x "$x")
  [[ -n $y ]] && args+=(-y "$y")
  tmux display-popup "${args[@]}" "$cmd"
}

# _session_cmd <session> <command>
_session_cmd() {
  printf "tmux new -A -s %s 'tmux set -w detach-on-destroy on; tmux setw status off; tmux set -w pane-border-status off; TMUX_SESSION=%s %s'" \
    "$1" "$1" "$2"
}

# _toggle_popup <session> <w> <h> <command> [dir] [x] [y]
_toggle_popup() {
  local session=$1 w=$2 h=$3 cmd=$4 dir=${5:-$PANE_PATH_FMT} x=${6:-} y=${7:-}
  if [[ $(tmux display-message -p '#S') == "$session" ]]; then
    tmux detach-client
    return
  fi
  _popup_run "$w" "$h" "$dir" "$x" "$y" "$(_session_cmd "$session" "$cmd")"
}

_tm_toggle_pane() {
  "$BIN_DIR/tm-toggle-pane" "$@"
}

#  +----------------------------------------------------------+
#  |                       APT AND DKPG                       |
#  +----------------------------------------------------------+
show_apt_search() {
  local -a pkgs=()
  mapfile -t pkgs < <(apt-cache pkgnames |
    _fzf_center 80% 50% --prompt="Apt Search> " --multi \
      --preview 'apt-cache show {1}' --preview-window right:70%:nohidden)

  ((${#pkgs[@]})) || return 0

  sudo apt-get install -y "${pkgs[@]}"
}

#  +----------------------------------------------------------+
#  |                           OPEN                           |
#  +----------------------------------------------------------+

_extract_urls() {
  local content=$1
  # Dari https://github.com/wfxr/tmux-fzf-url/blob/16381dce1c30fedd75fc775f887be7ea6c7cbf55/fzf-url.sh
  grep -oE '(https?|ftp|file):/?//[-A-Za-z0-9+&@#/%?=~_|!:,.;]*[-A-Za-z0-9+&@#/%=~_|]' <<<"$content"
  grep -oE '(https?://)?www\.[a-zA-Z](-?[a-zA-Z0-9])+\.[a-zA-Z]{2,}(/\S+)*' <<<"$content" |
    grep -vE '^https?://' | sed 's|^|http://|'
  grep -oE '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}(:[0-9]{1,5})?(/\S+)*' <<<"$content" |
    sed 's|^|http://|'
  grep -oE '(ssh://)?git@\S*' <<<"$content" |
    sed -E 's|:|/|g; s|^(ssh///)?git@(.*)$|https://\2|'
  grep -oE "['\"]([_A-Za-z0-9-]*/[_.A-Za-z0-9-]*)['\"]" <<<"$content" |
    sed -E "s/['\"]//g; s|^|https://github.com/|"
}

# open_url [filter-grep/awk/sed] [jumlah-baris-scrollback]
open_url() {
  local filter=${1:-} content extras="" items chosen url

  if is_vim; then
    dunstify -u low -t 10000 "URL extractor (Neovim mode)" \
      "Buffer cannot be accessed directly. Only clipboard/yank content will be used."
    content=$(_clipboard_paste)
  else
    content=$(_capture_pane_text "${2:-}")
  fi

  case $filter in
  grep* | awk* | sed*)
    extras=$(bash -c "$filter" <<<"$content") || extras=""
    ;;
  esac

  items=$({
    _extract_urls "$content"
    printf '%s\n' "$extras"
  } | grep -v '^$' | sort -u)

  if [[ -z $items ]]; then
    _tmux_error_msg "Searching URL Not Found!!"
    return
  fi

  chosen=$(_fzf_pick '@fzf-url-fzf-options' 'Open URL> ' <<<"$items")
  [[ -z $chosen ]] && return

  while read -r url; do
    open "$url" &>"/tmp/tmux-$UID-fzf-url.log"
  done <<<"$chosen"
}

_resolve_main_pane() {
  local session json pane_id log="/tmp/tm-jump-to-main-pane.log"
  session=$(tmux display-message -p '#S')
  json="/tmp/tmux-toggle-pane-$session.json"
  pane_id=$(jq -r '[.[] | .pane_id][0] // empty' "$json" 2>/dev/null)

  if [[ -z $pane_id ]] || ! tmux display-message -p -t "$pane_id" '#{pane_id}' &>/dev/null; then
    dunstify -u critical "TM-JUMP-TO-MAIN-PANE" \
      "Warning: main pane_id=${pane_id:-?} does not exist, check path $json and log $log"
    echo "Failed to open filename: $1" >"$log"
    return 1
  fi
  printf '%s' "$pane_id"
}

# open_find_filepath_and_linenumber [_]
open_find_filepath_and_linenumber() {
  if is_vim; then
    dunstify -u low -t 10000 "Find Error (Neovim mode)" \
      "Buffer cannot be accessed directly. Only clipboard/yank content will be used."
  fi

  local items chosen pane_id file line

  # pola path:num
  items=$(_capture_pane_text "${2:-}" | grep -oE '[~/.A-Za-z0-9_-]+:[0-9]+' | sort -u)

  if [[ -z $items ]]; then
    tmux display-message "Searching filepath:num not found!!"
    return
  fi

  chosen=$(_fzf_pick '@fzf-pathnum-fzf-options' 'Open path:num> ' <<<"$items")
  [[ -z $chosen ]] && return

  pane_id=$(_resolve_main_pane "$chosen") || exit 1

  while IFS=: read -r file line; do
    file=${file##*/}
    tmux send-keys -t "$pane_id" ":vsp +$line $file | wincmd =" Enter
    dunstify -t 2000 "Open Error Filepath" "$file line: $line"
  done <<<"$chosen"

  tmux select-pane -t "$pane_id"
}

open_calc() {
  _require_tmux
  _toggle_popup tmp_calculator 50% 50% \
    'python -ic "from __future__ import division; from math import *; from random import *"'
}

open_mutlilog() {
  _require_tmux
  tmux kill-window -t ':=logging' 2>/dev/null
  tmux new-window -n logging \; send-keys \
    "sudo multitail -s 2 -cS alf_log /var/log/syslog /var/log/auth.log /var/log/kern.log && tmux kill-pane" Enter
}

open_newsboat() {
  _require_tmux
  local session="tmp_newsboat" cmd=""

  if ! _is_session_exists "$session"; then
    cmd="newsboat -u $HOME/Dropbox/data.programming.forprivate/newsboat-urls"
    if [[ -n $(timeout 2 docker ps -q -f 'name=^torproxy$' 2>/dev/null) ]]; then
      cmd="proxychains -q $cmd"
    fi
  fi

  _toggle_popup "$session" 80% 80% "$cmd"
}

open_rkill() {
  _require_tmux
  local pid
  pid=$(ps -ef --no-headers | fzf-tmux -p 80% | awk '{print $2}')
  if [[ -n $pid ]]; then
    kill -9 "$pid"
  fi
}

open_calcure() {
  _require_tmux
  _toggle_popup tmp_calcure 80% 80% calcure
}

open_ps_btop() {
  _require_tmux
  _toggle_popup tmp_btop 90% 60% btop "$PANE_PATH_FMT" 80% 80%
}

open_ps_lsof() {
  _require_tmux
  local session="tmp_lsof" cmd=""

  if ! _is_session_exists "$session"; then
    local pgid pids
    pgid=$(ps -o pgid= -p $$ | tr -d '[:blank:]')

    pids=$(
      ps -eo user,pid,ppid,pgid,stat,tname,cmd |
        awk -v pgid="$pgid" '$4 != pgid || $2 == pgid' |
        grcat fps.grc |
        _fzf_center 80% 60% --header-lines=1 -m --ansi --min-height=15 --tac --reverse \
          --preview 'ps -o pcpu,pmem,vsz,rss,thcount,start_time,time -p {2}' \
          --preview-window down:10%:nohidden,border-top |
        awk '{print $2}' | paste -sd, -
    )

    [[ -z $pids ]] && return 0
    cmd="htop -p $pids"
  fi

  _toggle_popup "$session" 90% 50% "$cmd" "$PANE_PATH_FMT" 80% 80%
}

open_systemctl_ui() {
  _popup_run 80% 90% "$PANE_PATH_FMT" "" 80% "$(_session_cmd tmp_szy "$BIN_DIR/sysz")"
}

open_lazydocker() {
  _require_tmux
  _toggle_popup tmp_lazydocker 80% 80% "proxychains -q lazydocker"
}

