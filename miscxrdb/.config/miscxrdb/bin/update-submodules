#!/usr/bin/env bash

# Usage:
#   ./update-submodules.sh              # Update all submodules to their remote HEAD
#   ./update-submodules.sh <path>       # Update a specific submodule
#   DRY_RUN=1 ./update-submodules.sh    # Preview changes without applying them
#   BRANCH=main ./update-submodules.sh  # Force a specific branch

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'
log() { echo -e "${BLUE}==>${NC} $*"; }
ok() { echo -e "${GREEN}✓${NC} $*"; }
warn() { echo -e "${YELLOW}!${NC} $*"; }
err() { echo -e "${RED}✗${NC} $*" >&2; }

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

DRY_RUN="${DRY_RUN:-0}"
BRANCH="${BRANCH:-}"
TARGET="${1:-}"

log "Repo root: $REPO_ROOT"
log "Mode     : $([ "$DRY_RUN" = "1" ] && echo 'DRY-RUN' || echo 'APPLY')"
[ -n "$BRANCH" ] && log "Branch   : $BRANCH"

mapfile -t ALL_SUBMODULES < <(git config -f .gitmodules --get-regexp '^submodule\..*\.path$' | awk '{print $2}')

if [ -n "$TARGET" ]; then
  SUBMODULES=("$TARGET")
else
  SUBMODULES=("${ALL_SUBMODULES[@]}")
fi

log "Submodule count: ${#SUBMODULES[@]}"
echo ""

git submodule sync --recursive

for sm in "${SUBMODULES[@]}"; do
  if [ ! -d "$sm" ]; then
    warn "Skipping (not found): $sm"
    continue
  fi

  echo -e "${BLUE}--- $sm ---${NC}"

  # Initialize the submodule if it hasn't been initialized yet.
  if [ ! -e "$sm/.git" ]; then
    log "Init submodule"
    [ "$DRY_RUN" = "1" ] || git submodule init "$sm"
    [ "$DRY_RUN" = "1" ] || git submodule update --init --recursive "$sm"
  fi

  (
    cd "$sm"

    # Pick the target branch.
    if [ -n "$BRANCH" ]; then
      TARGET_BRANCH="$BRANCH"
    else
      TARGET_BRANCH="$(git symbolic-ref --short -q HEAD || git rev-parse --short HEAD)"
    fi

    log "Fetch origin..."
    [ "$DRY_RUN" = "1" ] && {
      ok "(dry) git fetch --prune origin"
      exit 0
    }
    git fetch --prune origin

    BEFORE="$(git rev-parse --short HEAD)"

    # Check whether the current branch has an upstream configured.
    if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
      log "Pulling latest changes from upstream ($TARGET_BRANCH)..."
      git pull --ff-only
    else
      # Fall back to the remote's default branch when no upstream is configured.
      warn "No upstream set for '$TARGET_BRANCH'. Falling back to the remote's default branch."

      REMOTE_HEAD="$(git remote show origin | awk '/HEAD branch/ {print $NF}')"

      if [ -n "$REMOTE_HEAD" ] && [ "$REMOTE_HEAD" != "$TARGET_BRANCH" ]; then
        git checkout "$REMOTE_HEAD"
        git pull --ff-only
      fi
    fi

    AFTER="$(git rev-parse --short HEAD)"

    if [ "$BEFORE" != "$AFTER" ]; then
      ok "Updated $BEFORE → $AFTER"
      git --no-pager log --oneline "$BEFORE..$AFTER" | head -n 10
    else
      ok "Already up-to-date ($AFTER)"
    fi
  )
  echo ""
done

echo -e "${BLUE}==> Final status:${NC}"
git submodule status --recursive

echo ""
echo -e "${YELLOW}Next step:${NC}"
echo -e "   git add ."
echo -e "   git commit -m 'chore(dotfiles): zsh submodules updated'"
echo -e "   git push"
