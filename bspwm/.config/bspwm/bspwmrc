# getcolors

getcolors() {
  eval "$(rdb -query 2>/dev/null | awk '
    {
      key = $1
      sub(/:$/, "", key)              # buang colon di akhir
      n = split(key, a, /[*.]+/)      # ambil bagian setelah * atau .
      name = a[n]
      val = $2
      if (val == "") next
      if (name == "background" && !b) b = val
      if (name == "color5"     && !m) m = val
      if (name == "color16"    && !k) k = val
      if (name == "color9"     && !c) c = val
    }
    END {
      printf "INACTIVE=%s\n", (b=="" ? "#1d1f21" : b)
      printf "MAGENTA=%s\n",  (m=="" ? "#b294bb" : m)
      printf "KEYWORD=%s\n",  (k=="" ? "#81a2be" : k)
      printf "CYAN=%s\n",     (c=="" ? "#8abeb7" : c)
    }')"

  # TMUX_SNAPSHOT_PATH="$HOME/.config/tmuxconfig/themes/tmux-snapshot"
  # if [ -f "$TMUX_SNAPSHOT_PATH" ]; then
  #   t=$(awk -F= 'toupper($1) ~ /TAB_ACTIVE_BG/ { gsub(/"/, "", $2); print $2; exit }' "$TMUX_SNAPSHOT_PATH")
  #   [ -n "$t" ] && INACTIVE=$t
  # fi
}
getcolors

# ─[ BSPWM CONFIG ]─────────────────────────────────────────────────────────────
bspc config normal_border_color "$INACTIVE"
bspc config focused_border_color "$KEYWORD"
bspc config active_border_color "$CYAN"
bspc config presel_feedback_color "$MAGENTA"

bspc monitor -d 1 2 3 4 5 6

bspc config border_width 4
bspc config window_gap 15
bspc config split_ratio 0.50
bspc config pointer_follows_focus false
bspc config borderless_monocle true
bspc config single_monocle true

bspc config pointer_action1 move
bspc config pointer_action2 resize_side
bspc config pointer_action3 resize_corner

bspc config external_rules_command "$HOME/.config/miscxrdb/bspwm/scripts/bspc-external-rules"

bspc wm --record-history on
xsetroot -cursor_name left_ptr

# ─[ RULES ]────────────────────────────────────────────────────────────────────
desk_code="1"
desk_web="2"
desk_doc="3"

bspc rule -r "*"

bspc rule -a URxvt:ncmpcpp state=floating
bspc rule -a st:ncmpcpp state=floating
bspc rule -a discord desktop=$desk_doc follow=on
bspc rule -a Firefox-esr desktop=$desk_web
bspc rule -a "Zen Browser" desktop=$desk_web
bspc rule -a Navigator desktop=$desk_web
bspc rule -a Yad state=floating center=off
bspc rule -a jetbrains-idea-ce desktop=$desk_code
bspc rule -a jetbrains-idea-c desktop=$desk_code
bspc rule -a Transmission-gtk state=tiled center=off
bspc rule -a Pulseeffects state=floating center=on
bspc rule -a Pulsemixer state=floating center=on
bspc rule -a '*:soffice' state=tiled desktop=$desk_doc

# ─[ Run eww in the background to avoid blocking. ]─────────────────────────────
[ -x "$HOME/.config/eww/starteww.sh" ] && run_disowned "$HOME/.config/eww/starteww.sh"

# ─[ WALLPAPER ]────────────────────────────────────────────────────────────────
FEHBG="$HOME/.config/miscxrdb/exbin/fehbg"
WALL_LOG="$RUNDIR/bspwm-wallpaper.log"

apply_wallpaper() {
  if [ ! -x "$FEHBG" ]; then
    echo "$(date +%T) fehbg tidak ada / tidak executable: $FEHBG" >>"$WALL_LOG"
    return 1
  fi
  command -v feh >/dev/null 2>&1 || {
    echo "$(date +%T) feh tidak terinstall" >>"$WALL_LOG"
    return 1
  }

  i=0
  while [ "$i" -lt 8 ]; do
    if "$FEHBG" >>"$WALL_LOG" 2>&1 &&
      xprop -root _XROOTPMAP_ID ESETROOT_PMAP_ID 2>/dev/null | grep -q 'pixmap id'; then
      return 0
    fi
    i=$((i + 1))
    sleep 0.5
  done
  echo "$(date +%T) gagal set wallpaper setelah 8 percobaan" >>"$WALL_LOG"
  return 1
}

(
  sleep 1 # Give eww and the monitor setup time to settle.
  apply_wallpaper
  # Re-apply whenever the monitor configuration changes (xrandr/hotplug resets
  # the root window).
  # This loop exits automatically when bspwm restarts (the socket is closed).
  bspc subscribe monitor_add monitor_remove monitor_geometry | while read -r _; do
    sleep 0.5
    apply_wallpaper
  done
) >/dev/null 2>&1 &

# ─[ STARTUP ]──────────────────────────────────────────────────────────────────
if [ ! -f "$STARTUP_LOCK_FILE" ]; then
  : >"$STARTUP_LOCK_FILE"

  [ -f "$HOME/.config/dunst/rundust.sh" ] && run_once dunst "$HOME/.config/dunst/rundust.sh"
  [ -n "$TERMINAL" ] && run_once "$(basename "$TERMINAL")" "$TERMINAL"
  run_once chrome google-chrome

  [ -f ~/.lesskey ] && [ ! -f ~/.less ] && lesskey

  # Dropbox is resource-intensive; delay startup to avoid competing for
  # resources during boot.
  if [ -x "$HOME/.dropbox-dist/dropboxd" ]; then
    (
      sleep 5
      run_once dropbox "$HOME/.dropbox-dist/dropboxd"
    ) >/dev/null 2>&1 &
  fi
fi
