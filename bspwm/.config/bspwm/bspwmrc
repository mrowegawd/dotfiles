#!/bin/sh

# ─[ ENVIRONMENT ]──────────────────────────────────────────────────────────────
[ -f ~/.xprofile ] && . ~/.xprofile
[ -f "$HOME/.profile" ] && . "$HOME/.profile"

export SXHKD_SHELL=/usr/bin/sh

RUNDIR="${XDG_RUNTIME_DIR:-/tmp}"
# Fallback: if this variable is unset, `[ ! -f "" ]` would always evaluate to true.
STARTUP_LOCK_FILE="${STARTUP_LOCK_FILE:-$RUNDIR/bspwm-startup.lock}"

[ -f ~/.Xresources ] && xrdb -merge ~/.Xresources

# ─[ HELPERS ]──────────────────────────────────────────────────────────────────
run_disowned() {
  nohup "$@" >/dev/null 2>&1 &
}

run_once() {
  pgrep -x "$1" >/dev/null 2>&1 && return 0
  shift
  run_disowned "$@"
}

pkill -x sxhkd
n=0
while pgrep -x sxhkd >/dev/null 2>&1 && [ "$n" -lt 20 ]; do
  sleep 0.05
  n=$((n + 1))
done
run_disowned sxhkd

run_once xsettingsd xsettingsd

# ─[ KEYBOARD ]─────────────────────────────────────────────────────────────────
(
  setxkbmap -option caps:backspace
  xset r rate 200 25
  xset r 66
) >/dev/null 2>&1 &

